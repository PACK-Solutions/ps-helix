{
  "name": "ps-helix",
  "version": "6.2.4",
  "description": "Helix Design System - A comprehensive Angular component library",
  "author": "Fabrice PEREZ - Design Engineer at PACK Solutions",
  "license": "MIT",
  "homepage": "https://ps-helix.com/",
  "keywords": [
    "angular",
    "design-system",
    "component-library",
    "ui-components",
    "helix"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PACK-Solutions/ps-helix.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.6.0",
    "@phosphor-icons/web": "2.0.3"
  },
  "exports": {
    "./styles.css": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./styles-full.css": {
      "style": "./styles-full.css",
      "default": "./styles-full.css"
    },
    "./src/lib/styles/*": {
      "style": "./src/lib/styles/*",
      "default": "./src/lib/styles/*"
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
