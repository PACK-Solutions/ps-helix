{
  "name": "Ps-helix-design-system",
  "private": true,
  "version": "7.0.1",
  "description": "Helix Design System",
  "author": "Fabrice PEREZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PACK-Solutions/ps-helix"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "start": "ng serve --configuration development",
    "build": "rm -rf dist && ng build",
    "dev": "npm run start",
    "build:lib": "ng build ps-helix",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "docs:tokens": "node scripts/generate-token-reference.mjs",
    "verify:tokens": "node scripts/generate-token-reference.mjs --check",
    "docs:classes": "node scripts/verify-class-namespace.mjs",
    "verify:classes": "node scripts/verify-class-namespace.mjs --check",
    "docs:auto-dark": "node scripts/generate-auto-dark.mjs",
    "verify:auto-dark": "node scripts/generate-auto-dark.mjs --check",
    "verify:breakpoints": "node scripts/verify-breakpoints.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "probe:responsive": "node -e \"require('fs').copyFileSync('scripts/probe-responsive.html','src/assets/probe-responsive.html')\" && echo \"npm start, puis http://localhost:4200/assets/probe-responsive.html\"",
    "verify:public-api": "node scripts/verify-public-api.mjs",
    "verify:i18n-preset": "node scripts/verify-i18n-preset.mjs",
    "docs:config": "node scripts/generate-config-reference.mjs",
    "verify:config": "node scripts/generate-config-reference.mjs --check",
    "publish:lib": "npm publish ./dist/ps-helix --access public",
    "watch:lib": "ng build ps-helix --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint projects/ps-helix/src --max-warnings 0",
    "format": "prettier --write \"projects/ps-helix/src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"projects/ps-helix/src/**/*.{ts,html,css,json}\"",
    "size": "size-limit"
  },
  "dependencies": {
    "@angular/animations": "22.0.4",
    "@angular/common": "22.0.4",
    "@angular/compiler": "22.0.4",
    "@angular/core": "22.0.4",
    "@angular/forms": "22.0.4",
    "@angular/platform-browser": "22.0.4",
    "@angular/platform-browser-dynamic": "22.0.4",
    "@angular/router": "22.0.4",
    "@ngx-translate/core": "^15.0.0",
    "@phosphor-icons/web": "^2.0.3",
    "date-fns": "^3.3.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.5",
    "@angular/cli": "22.0.5",
    "@angular/compiler-cli": "22.0.4",
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.39.4",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^17.0.0",
    "ng-packagr": "22.0.1",
    "prettier": "^3.9.4",
    "size-limit": "^12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
